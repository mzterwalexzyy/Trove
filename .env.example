# Copy to .env and fill in. Never commit the real file: .env is gitignored.

# --- Escrow (server-side only, never exposed to the client) -----------------
# Hex private key of the escrow wallet. The escrow address is derived from
# this rather than configured separately, so the two cannot drift apart.
# TESTNET ONLY. Rotate before any mainnet use.
NUXT_ESCROW_PRIVATE_KEY=

# Seals the session cookie. Any long random string; 32+ bytes recommended.
NUXT_SESSION_PASSWORD=

# --- Nimiq network ----------------------------------------------------------
NUXT_NIMIQ_RPC_URL=https://rpc.testnet.nimiqwatch.com/
NUXT_PUBLIC_NIMIQ_NETWORK=test
NUXT_PUBLIC_EXPLORER_BASE=https://test.nimiq.watch

# --- Database ---------------------------------------------------------------
# Omit both to fall back to a local SQLite file at .data/nimiq-bounty.db.
# A local file does not persist on serverless, so production needs these.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Keeper, the bounty drafting assistant (optional) -----------------------
# With no key, the create form stays manual instead of erroring, so leaving
# these blank is a supported configuration rather than a broken one.
NUXT_AI_API_KEY=
NUXT_AI_BASE_URL=https://openrouter.ai/api/v1
NUXT_AI_MODEL=
